# Firebase Configuration (Authentication & Cloud Firestore)
# To obtain these, create a web app in your Firebase Console (firebase.google.com)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# AI & Speech-to-Text (STT) Configuration
# Deepgram is the primary high-performance speech transcription provider
VITE_DEEPGRAM_API_KEY=your-deepgram-api-key

# OpenAI is used for entry insights/analysis (GPT-4o-mini) and fallback speech transcription (Whisper)
VITE_OPENAI_API_KEY=sk-your-openai-api-key
